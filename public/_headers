# Caching (2026-11-26). Card scans have a fingerprint (or eBay item id) in the file name, so a file never changes:
# browsers keep them for a year instead of re-checking all of them on every visit.
/img/scans/*
  Cache-Control: public, max-age=31536000, immutable
# Small site images that can be replaced in place: use the copy you have for an hour, then refresh in the background.
/img/sales/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/symbols/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/chars/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/char-art/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/theme-faces/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# Card list (audit fix 2026-11-27): browsers reuse their copy for 5 minutes, then refresh it in the background.
# The sync job rebuilds it at most every 15 minutes, so visitors are never more than a few minutes behind.
/cards.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/chars.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
# Grid thumbnails (pipeline/thumbs.py): named by a hash of the source image, so a file never changes.
/img/t/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
